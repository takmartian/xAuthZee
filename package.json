{
  "name": "xauthzee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:all": "wxt build && wxt build -b edge",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:all": "wxt zip && wxt zip -b edge",
    "compile": "tsc --noEmit",
    "test": "node --test tests/unit.test.ts",
    "icons": "node scripts/gen-icons.mjs",
    "serve:fixtures": "python3 -m http.server 5599 --bind 127.0.0.1 --directory tests/fixtures",
    "test:style": "node tests/style-isolation.mjs",
    "test:position": "node tests/positioning-strategy.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "wxt": "^0.21.2"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "otpauth": "^9.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
